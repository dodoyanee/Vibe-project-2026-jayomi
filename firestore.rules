rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'username', 'usernameKey', 'email', 'role', 'createdAt', 'agreements'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.username.matches('^[a-z0-9._-]{3,20}$')
        && request.resource.data.usernameKey.matches('^[a-z0-9._-]{3,20}$')
        && request.resource.data.usernameKey == request.resource.data.username
        && request.resource.data.usernameKey != 'admin'
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email != 'admin.com@company.co.kr'
        && request.resource.data.role == 'ueser'
        && request.resource.data.createdAt == request.time
        && (!('agreements' in request.resource.data)
          || (request.resource.data.agreements is map
            && request.resource.data.agreements.keys().hasAll(['terms', 'privacy', 'marketing'])
            && request.resource.data.agreements.keys().hasOnly(['terms', 'privacy', 'marketing'])
            && request.resource.data.agreements.terms == true
            && request.resource.data.agreements.privacy == true
            && request.resource.data.agreements.marketing is bool))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid;
      allow update, delete: if false;
    }

    match /usernames/{usernameKey} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey == usernameKey;
      allow update, delete: if false;
    }
  }
}
